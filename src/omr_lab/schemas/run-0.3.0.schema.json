{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omr-lab:schema:run:0.3.0",
  "title": "OMR Lab run document",
  "description": "Normalized record of one OMR pipeline run (the run envelope). Records only facts supported by the pipeline and engine output; see docs/json-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "input",
    "engine",
    "options",
    "artifacts",
    "preprocessing",
    "timing",
    "score",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this contract. Changes to the contract require a new schema file and version.",
      "const": "0.3.0"
    },
    "status": {
      "description": "Outcome of the run. 'succeeded' means the pipeline completed; it is not a claim that the music was recognized correctly.",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "input": {
      "description": "The source document given to the pipeline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "media_type"
      ],
      "properties": {
        "filename": {
          "description": "Base name of the input file (no directory components).",
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "media_type": {
          "description": "IANA media type of the input, or null when it was not determined.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
        },
        "sha256": {
          "description": "Optional lowercase hex SHA-256 digest of the input bytes, or null when not computed.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "engine": {
      "description": "Provenance of the OMR engine that was selected for the run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "description": "Stable engine identifier (Engine.name).",
          "type": "string",
          "minLength": 1
        },
        "version": {
          "description": "Engine version as reported by the engine, or null when unknown. Never guessed.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "options": {
      "$comment": "Effective engine options as echoed by the adapter (issue #21). Keys are option names; values are the effective JSON values, defaults included. Empty when the engine did not return a result.",
      "description": "Effective run/engine options recorded for provenance.",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      }
    },
    "artifacts": {
      "description": "Raw engine and pipeline artifacts, keyed by artifact kind (e.g. 'musicxml', or 'preprocessed_image' for the image given to the engine after preprocessing). Values are POSIX-style paths relative to the run output directory (no absolute paths, backslashes, control characters such as newlines, or '..' segments). Kept separate from normalized content.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/relativePosixPath"
      }
    },
    "preprocessing": {
      "description": "Optional image preprocessing applied to a copy of the input before recognition (docs/preprocessing.md), or null when none was requested or the run stopped before preprocessing (for example an invalid input). The engine read the preprocessed copy; input describes the original file, which is never modified.",
      "type": [
        "object",
        "null"
      ],
      "if": {
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/preprocessing"
      }
    },
    "timing": {
      "description": "Wall-clock timing of the run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds"
      ],
      "properties": {
        "duration_seconds": {
          "description": "Total elapsed time of the run in seconds.",
          "type": "number",
          "minimum": 0
        },
        "started_at": {
          "description": "Optional RFC 3339 timestamp at which the run started, or null.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "score": {
      "description": "Normalized musical content (docs/score-model.md), or null when no normalized musical content is available; null is not an empty or recognized score.",
      "type": [
        "object",
        "null"
      ],
      "$comment": "if/then instead of oneOf so a violation is reported at its own path, not as 'not valid under any of the given schemas'.",
      "if": {
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/score"
      }
    },
    "warnings": {
      "description": "Non-fatal problems observed during the run, in order of occurrence.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "description": "Stable snake_case warning identifier.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "description": "Human-readable explanation.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "description": "Failure details. Required to be an object when status is 'failed' and null when status is 'succeeded'.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "Stable snake_case error identifier (see docs/json-schema.md for known codes).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "description": "Actionable, human-readable explanation.",
          "type": "string",
          "minLength": 1
        },
        "returncode": {
          "description": "Engine process return code when the failure came from an external process, otherwise null.",
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "relativePosixPath": {
      "$comment": "One rule per entry so a violation names the broken rule. Control characters are rejected first; the other patterns can then assume a single line.",
      "description": "A POSIX-style path relative to the run output directory.",
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "description": "must not contain control characters such as newlines or tabs",
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        {
          "description": "must be relative, not start with '/'",
          "not": {
            "pattern": "^/"
          }
        },
        {
          "description": "must not start with a Windows drive prefix such as 'C:'",
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "description": "must use '/' as the separator, not '\\'",
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "description": "must not contain a '..' segment",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "rational": {
      "description": "Non-negative exact rational in whole notes, written 'n' or 'n/d' in lowest terms (a quarter note is '1/4', a dotted half '3/4').",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"
    },
    "nullableRational": {
      "if": {
        "not": {
          "type": "null"
        }
      },
      "then": {
        "$ref": "#/$defs/rational"
      },
      "description": "A rational, or null when unknown."
    },
    "score": {
      "description": "A score derived from one source artifact. Every value is read from the source; unknown values are null, never guessed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "work_title",
        "work_number",
        "movement_title",
        "movement_number",
        "creators",
        "parts"
      ],
      "properties": {
        "source": {
          "description": "Where the content was read from.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "artifact"
          ],
          "properties": {
            "format": {
              "description": "Source format.",
              "enum": [
                "musicxml"
              ]
            },
            "artifact": {
              "description": "Artifact kind (a key of artifacts) of the source file, or null when it is not a recorded artifact.",
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "work_title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "work_number": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "movement_title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "movement_number": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "creators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name"
            ],
            "properties": {
              "type": {
                "description": "Creator role as given, e.g. 'composer' or 'lyricist'; null when not given.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "abbreviation",
        "measures"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "abbreviation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "implicit",
        "barlines",
        "events"
      ],
      "properties": {
        "number": {
          "description": "Measure number attribute as written (a string; may be non-numeric), or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "implicit": {
          "description": "True when the source marks the measure as implicit (a pickup or a split measure); it does not count in measure numbering.",
          "type": "boolean"
        },
        "barlines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/barline"
          }
        },
        "events": {
          "description": "Musical events in source order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "barline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "style",
        "repeat",
        "ending"
      ],
      "properties": {
        "location": {
          "enum": [
            "left",
            "right",
            "middle"
          ]
        },
        "style": {
          "description": "MusicXML bar-style value (e.g. 'light-heavy'), or null when not given.",
          "type": [
            "string",
            "null"
          ]
        },
        "repeat": {
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "direction",
              "times"
            ],
            "properties": {
              "direction": {
                "enum": [
                  "forward",
                  "backward"
                ]
              },
              "times": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        },
        "ending": {
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "type",
              "text"
            ],
            "properties": {
              "number": {
                "description": "Ending numbers as written, e.g. '1' or '1, 2'.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "start",
                  "stop",
                  "discontinue"
                ]
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "event": {
      "description": "A musical event; 'kind' selects which fields it has.",
      "$comment": "Dispatch on 'kind' with if/then so a violation is reported inside the matching event shape.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "note",
            "rest",
            "harmony",
            "tempo",
            "clef",
            "key",
            "time"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/noteEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rest"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/restEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "harmony"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/harmonyEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tempo"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/tempoEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "clef"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/clefEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "key"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/keyEvent"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "time"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "$ref": "#/$defs/timeEvent"
          }
        }
      ]
    },
    "noteEvent": {
      "description": "A note or chord.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "voice",
        "staff",
        "duration",
        "type",
        "dots",
        "time_modification",
        "tuplets",
        "grace",
        "pitches",
        "lyrics"
      ],
      "properties": {
        "kind": {
          "const": "note"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "voice": {
          "description": "<voice> as written, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration": {
          "description": "Sounding duration in whole notes from <duration> and <divisions>; null for grace notes or when <divisions> is unknown.",
          "$ref": "#/$defs/nullableRational"
        },
        "type": {
          "description": "Notated value from <type> (e.g. 'quarter', 'eighth'), or null when not given.",
          "type": [
            "string",
            "null"
          ]
        },
        "dots": {
          "type": "integer",
          "minimum": 0
        },
        "time_modification": {
          "$ref": "#/$defs/timeModification"
        },
        "tuplets": {
          "description": "Tuplet bracket starts and stops on this note, from <notations><tuplet>.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "number"
            ],
            "properties": {
              "type": {
                "enum": [
                  "start",
                  "stop"
                ]
              },
              "number": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "grace": {
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slash"
            ],
            "properties": {
              "slash": {
                "type": "boolean"
              }
            }
          }
        },
        "pitches": {
          "description": "One pitch, or several for a chord (MusicXML <chord/> notes are merged into the first note).",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pitch"
          }
        },
        "lyrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lyric"
          }
        }
      }
    },
    "restEvent": {
      "description": "A rest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "voice",
        "staff",
        "duration",
        "type",
        "dots",
        "time_modification",
        "tuplets",
        "measure_rest",
        "hidden"
      ],
      "properties": {
        "kind": {
          "const": "rest"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "voice": {
          "description": "<voice> as written, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration": {
          "description": "Sounding duration in whole notes from <duration> and <divisions>; null for grace notes or when <divisions> is unknown.",
          "$ref": "#/$defs/nullableRational"
        },
        "type": {
          "description": "Notated value from <type> (e.g. 'quarter', 'eighth'), or null when not given.",
          "type": [
            "string",
            "null"
          ]
        },
        "dots": {
          "type": "integer",
          "minimum": 0
        },
        "time_modification": {
          "$ref": "#/$defs/timeModification"
        },
        "tuplets": {
          "description": "Tuplet bracket starts and stops on this note, from <notations><tuplet>.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "number"
            ],
            "properties": {
              "type": {
                "enum": [
                  "start",
                  "stop"
                ]
              },
              "number": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "measure_rest": {
          "description": "True for <rest measure=\"yes\">, a whole-measure rest.",
          "type": "boolean"
        },
        "hidden": {
          "description": "True for a rest in <note print-object=\"no\">: a placeholder that is not printed (ABC 'x' rather than 'z').",
          "type": "boolean"
        }
      }
    },
    "harmonyEvent": {
      "description": "A chord symbol (<harmony> with a <root>).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "staff",
        "root",
        "chord_kind",
        "chord_kind_text",
        "bass",
        "degrees"
      ],
      "properties": {
        "kind": {
          "const": "harmony"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "root": {
          "$ref": "#/$defs/pitchClass"
        },
        "chord_kind": {
          "description": "MusicXML <kind> value, e.g. 'major', 'minor-seventh'; null when empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "chord_kind_text": {
          "description": "<kind text> as printed (e.g. 'm7'): null when absent, '' when no kind text is printed.",
          "type": [
            "string",
            "null"
          ]
        },
        "bass": {
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "$ref": "#/$defs/pitchClass"
          }
        },
        "degrees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "alter",
              "type"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "alter": {
                "type": "number"
              },
              "type": {
                "enum": [
                  "add",
                  "alter",
                  "subtract"
                ]
              }
            }
          }
        }
      }
    },
    "tempoEvent": {
      "description": "A tempo mark (a <direction> or <sound> with a tempo).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "staff",
        "bpm",
        "beat_unit",
        "beat_unit_dots",
        "per_minute",
        "words"
      ],
      "properties": {
        "kind": {
          "const": "tempo"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bpm": {
          "description": "Quarter notes per minute from <sound tempo>, or null.",
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "beat_unit": {
          "description": "<metronome><beat-unit>, e.g. 'quarter', or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "beat_unit_dots": {
          "type": "integer",
          "minimum": 0
        },
        "per_minute": {
          "description": "<metronome><per-minute> as written (may be text such as '120-132'), or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "words": {
          "description": "<words> text of the same direction (e.g. 'Moderato'), or null.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "clefEvent": {
      "description": "A clef.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "staff",
        "sign",
        "line",
        "octave_change"
      ],
      "properties": {
        "kind": {
          "const": "clef"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sign": {
          "enum": [
            "G",
            "F",
            "C",
            "percussion",
            "TAB",
            "jianpu",
            "none"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "octave_change": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "keyEvent": {
      "description": "A traditional key signature.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "staff",
        "fifths",
        "mode"
      ],
      "properties": {
        "kind": {
          "const": "key"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fifths": {
          "description": "Sharps (positive) or flats (negative) in the key signature.",
          "type": "integer",
          "minimum": -11,
          "maximum": 11
        },
        "mode": {
          "description": "<mode> as written (e.g. 'major', 'minor'), or null when not given.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeEvent": {
      "description": "A time signature.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "staff",
        "beats",
        "beat_type",
        "symbol"
      ],
      "properties": {
        "kind": {
          "const": "time"
        },
        "offset": {
          "description": "Position from the start of the measure in whole notes; null when it cannot be computed (no <divisions>).",
          "$ref": "#/$defs/nullableRational"
        },
        "staff": {
          "description": "<staff> number (1-based), or null when not given.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "beats": {
          "description": "<beats> as written (may be '3+2').",
          "type": "string",
          "minLength": 1
        },
        "beat_type": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "description": "<time symbol>, e.g. 'common', 'cut', or null.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "alter",
        "octave",
        "ties"
      ],
      "properties": {
        "step": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        "alter": {
          "description": "Chromatic alteration in semitones (may be fractional). 0 when the source has no <alter>, which MusicXML defines as no alteration.",
          "type": "number"
        },
        "octave": {
          "description": "Scientific pitch notation octave; middle C is C4.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "ties": {
          "description": "Tie ends at this pitch, from <tie type>.",
          "type": "array",
          "items": {
            "enum": [
              "start",
              "stop"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "pitchClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "alter"
      ],
      "properties": {
        "step": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        "alter": {
          "description": "Chromatic alteration in semitones (may be fractional for microtones).",
          "type": "number"
        }
      }
    },
    "timeModification": {
      "if": {
        "not": {
          "type": "null"
        }
      },
      "then": {
        "description": "Tuplet ratio: actual_notes in the time of normal_notes.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actual_notes",
          "normal_notes"
        ],
        "properties": {
          "actual_notes": {
            "type": "integer",
            "minimum": 1
          },
          "normal_notes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "lyric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "syllabic",
        "text",
        "extend",
        "elided"
      ],
      "properties": {
        "number": {
          "description": "Verse/line identifier as written in <lyric number> (usually '1', '2', ...), or null when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "<lyric name> as written (e.g. 'verse', 'chorus'), or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "syllabic": {
          "description": "Position of the syllable in its word; null when not given.",
          "enum": [
            "single",
            "begin",
            "middle",
            "end",
            null
          ]
        },
        "text": {
          "description": "Syllable text; several <text> parts joined with the text of the <elision> between them (an empty <elision/> adds nothing). null when the lyric has no text (an extender-only lyric).",
          "type": [
            "string",
            "null"
          ]
        },
        "extend": {
          "description": "Melisma extender from <extend>: an object with its type (null when the source gives no type), or null when the lyric has no <extend>.",
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "start",
                  "stop",
                  "continue",
                  null
                ]
              }
            }
          }
        },
        "elided": {
          "description": "True when the lyric contains <elision>: several syllables sung on this one note.",
          "type": "boolean"
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "orientation_applied",
        "steps",
        "output",
        "output_sha256",
        "duration_seconds"
      ],
      "properties": {
        "requested": {
          "description": "Step names as requested, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "orientation_applied": {
          "description": "Whether the input's EXIF orientation tag turned or mirrored the image before the steps ran (the output PNG has no tag); null when preprocessing failed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "steps": {
          "description": "One record per step that ran, in order. On success every requested step is listed; when preprocessing failed (see error), the list is empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/preprocessingStep"
          }
        },
        "output": {
          "description": "Path of the image given to the engine, relative to the run output directory (also recorded as the 'preprocessed_image' artifact); null when preprocessing failed.",
          "if": {
            "not": {
              "type": "null"
            }
          },
          "then": {
            "$ref": "#/$defs/relativePosixPath"
          }
        },
        "output_sha256": {
          "description": "Lowercase hex SHA-256 of the output image, or null when there is none.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_seconds": {
          "description": "Time spent reading, transforming and writing the image.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "preprocessingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params",
        "applied",
        "result",
        "message",
        "duration_seconds"
      ],
      "properties": {
        "name": {
          "description": "Step name (docs/preprocessing.md).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "params": {
          "description": "The step's effective parameters.",
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "applied": {
          "description": "Whether the step changed the image. A step that finds nothing to correct, or no reliable evidence, leaves the image unchanged and says why in message.",
          "type": "boolean"
        },
        "result": {
          "description": "What the step measured, such as detected page corners in pixels of the step's input image or the rotation applied. Measurements, not ground truth; empty when there is nothing to report.",
          "type": "object"
        },
        "message": {
          "description": "Why the step left the image unchanged, or another note; null when there is none.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
